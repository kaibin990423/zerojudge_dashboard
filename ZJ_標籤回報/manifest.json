{
  "manifest_version": 3,
  "name": "ZeroJudge 題庫助手",
  "version": "1.0",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://zerojudge.tw/ShowProblem?problemid=*"],
      "js": ["content.js"]
    }
  ]
}